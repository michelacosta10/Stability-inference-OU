# Common style of all paper figures (main and SI). Figures are made at their final print width
# (89 mm one column, 183 mm two columns, see paperstyle.py), so these sizes are the printed sizes.
# Same sizes in main and SI: axis labels 10.5 pt, legends 10 pt, titles 9 pt, tick numbers 7 pt, panel letters 9 pt bold.

font.family         : sans-serif
font.sans-serif     : Nimbus Sans, Helvetica, Arial, DejaVu Sans
mathtext.fontset    : stixsans
font.size           : 9
axes.labelsize      : 10.5
axes.titlesize      : 9
xtick.labelsize     : 7
ytick.labelsize     : 7
legend.fontsize     : 10
legend.title_fontsize : 10
figure.titlesize    : 9

axes.linewidth      : 0.8
axes.titlepad       : 3
axes.labelpad       : 2
axes.spines.top     : False
axes.spines.right   : False
axes.grid           : False
grid.linewidth      : 0.5
grid.alpha          : 0.35

xtick.major.width   : 0.8
ytick.major.width   : 0.8
xtick.minor.width   : 0.6
ytick.minor.width   : 0.6
xtick.major.size    : 3
ytick.major.size    : 3
xtick.minor.size    : 1.8
ytick.minor.size    : 1.8
xtick.major.pad     : 2
ytick.major.pad     : 2

lines.linewidth     : 1.25
lines.markersize    : 4
patch.linewidth     : 1.0
hatch.linewidth     : 0.8
errorbar.capsize    : 2

legend.frameon      : False
legend.handlelength : 1.8
legend.handletextpad: 0.5
legend.borderaxespad: 0.3
legend.labelspacing : 0.3
legend.columnspacing: 1.0

figure.dpi          : 150
savefig.dpi         : 600
savefig.bbox        : standard   # exact print size: layout is done by constrained_layout
pdf.fonttype        : 42
ps.fonttype         : 42
